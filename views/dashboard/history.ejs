<% /* Global history page with items that link to their history hub. */ %>
<%- include("../includes/header", { title }) %>

<section class="mb-6 rounded-3xl bg-white p-5 shadow-soft sm:p-6">
  <p class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-600">History</p>
  <h1 class="mt-2 text-2xl font-semibold sm:text-3xl">Item history</h1>
  <p class="mt-2 text-sm text-slate-500">Search an item, then open its history page to review OH qty, min/max qty, cost, and price changes.</p>
</section>

<section class="mb-6 rounded-3xl bg-white p-5 shadow-soft">
  <input id="history-search" type="text" placeholder="Search by item number, name, or category..." data-initial-visible-count="10" class="w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 text-sm">
</section>

<section class="table-scroll mb-6 overflow-x-auto rounded-3xl bg-white shadow-soft">
  <table id="history-table" class="responsive-table min-w-full text-left text-sm">
    <thead class="bg-slate-50 text-slate-600">
      <tr>
        <th class="px-4 py-3">Item Number</th>
        <th class="px-4 py-3">Name</th>
        <th class="px-4 py-3">Category</th>
        <th class="px-4 py-3">Current</th>
        <th class="px-4 py-3">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200">
      <% if (items.length) { items.forEach((item) => { %>
        <tr data-row class="hover:bg-slate-50">
          <td data-label="Item Number" class="px-4 py-3 font-medium"><%= item.barcode %></td>
          <td data-label="Name" class="px-4 py-3"><%= item.name %></td>
          <td data-label="Category" class="px-4 py-3"><%= item.category_name || "No Category" %></td>
          <td data-label="Current" class="px-4 py-3 text-xs text-slate-500">
            OH: <%= item.quantity %><br>
            Min/Max: <%= item.min_quantity %>/<%= item.max_quantity %><br>
            Cost: PHP <%= formatCurrency(item.cost) %><br>
            Price: PHP <%= formatCurrency(item.price) %>
          </td>
          <td data-label="Actions" class="px-4 py-3">
            <a href="/inventory/items/<%= item.id %>/history" class="rounded-xl border border-slate-300 px-3 py-2 text-center text-xs font-semibold text-slate-700">Open History</a>
          </td>
        </tr>
      <% }) } else { %>
        <tr><td colspan="5" class="px-4 py-8 text-center text-slate-500">No items found.</td></tr>
      <% } %>
    </tbody>
  </table>
  <p id="history-empty-search" class="hidden p-6 text-center text-sm text-slate-500">No items found.</p>
</section>

<%- include("../includes/footer") %>
