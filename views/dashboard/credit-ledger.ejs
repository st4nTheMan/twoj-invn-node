<% /* Credit-ledger page for manual entries and credit transactions. */ %>
<%- include("../includes/header", { title }) %>

<section class="mb-6 rounded-3xl bg-gradient-to-r from-violet-500 to-indigo-500 p-5 text-white shadow-soft sm:p-6">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-violet-100">Credit Ledger</p>
      <h1 class="mt-2 text-2xl font-semibold sm:text-3xl">Track customer balances and manual credit entries.</h1>
      <p class="mt-2 max-w-2xl text-sm text-violet-100">Credit sales from Transactions appear here automatically, and you can also add a balance manually when needed.</p>
    </div>
    <button type="button" data-open-modal="add-credit-ledger-modal" class="rounded-2xl bg-white px-4 py-3 text-sm font-semibold text-violet-700 shadow-sm transition hover:bg-violet-50">Add Credit Entry</button>
  </div>
</section>

<section class="mb-6 grid gap-4 xl:grid-cols-[1.15fr_1fr]">
  <article class="rounded-3xl bg-white p-5 shadow-soft">
    <div class="flex items-center justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Registered Customers</p>
        <p class="mt-2 text-3xl font-semibold text-slate-950"><%= customerSummaries.length %></p>
      </div>
      <div class="text-right">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Outstanding Balance</p>
        <p class="mt-2 text-2xl font-semibold text-violet-700">
          PHP <%= formatCurrency(customerSummaries.reduce((sum, customer) => sum + Number(customer.total_balance_due || 0), 0)) %>
        </p>
      </div>
    </div>
  </article>

  <article class="rounded-3xl bg-white shadow-soft">
    <div class="border-b border-slate-200 px-5 py-4">
      <h2 class="text-lg font-semibold text-slate-950">Customer Balances</h2>
      <p class="mt-1 text-sm text-slate-500">Registered customers make it easier to review each person’s total credit and remaining balance.</p>
    </div>
    <div class="table-scroll max-h-[22rem] overflow-x-auto overflow-y-auto">
      <table class="responsive-table min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-slate-600">
          <tr>
            <th class="px-4 py-3">Customer</th>
            <th class="px-4 py-3">Entries</th>
            <th class="px-4 py-3">Total Credit</th>
            <th class="px-4 py-3">Balance Due</th>
            <% if (can("credit_ledger.create")) { %>
              <th class="px-4 py-3">Action</th>
            <% } %>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% if (customerSummaries.length) { customerSummaries.forEach((customer) => { %>
            <tr class="hover:bg-slate-50">
              <td data-label="Customer" class="px-4 py-3 align-top">
                <div class="font-semibold text-slate-900"><%= customer.name %></div>
                <div class="text-xs text-slate-500"><%= customer.phone %></div>
              </td>
              <td data-label="Entries" class="px-4 py-3 text-slate-600"><%= customer.entry_count %></td>
              <td data-label="Total Credit" class="px-4 py-3 text-slate-600">PHP <%= formatCurrency(customer.total_credit_amount) %></td>
              <td data-label="Balance Due" class="px-4 py-3 font-semibold text-violet-700">PHP <%= formatCurrency(customer.total_balance_due) %></td>
              <% if (can("credit_ledger.create")) { %>
                <td data-label="Action" class="px-4 py-3 align-top">
                  <% if (Number(customer.total_balance_due || 0) > 0) { %>
                    <button
                      type="button"
                      class="open-settle-credit-modal-button rounded-xl border border-emerald-200 px-3 py-2 text-xs font-semibold text-emerald-700 transition hover:bg-emerald-50"
                      data-customer-id="<%= customer.customer_id %>"
                      data-customer-name="<%= customer.name %>"
                      data-balance-due="<%= Number(customer.total_balance_due || 0).toFixed(2) %>"
                    >
                      Mark as Paid
                    </button>
                  <% } else { %>
                    <span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-500">Settled</span>
                  <% } %>
                </td>
              <% } %>
            </tr>
          <% }) } else { %>
            <tr><td colspan="<%= can('credit_ledger.create') ? 5 : 4 %>" class="px-4 py-8 text-center text-slate-500">No registered customers yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </article>
</section>

<section class="rounded-3xl bg-white shadow-soft">
  <div class="border-b border-slate-200 p-5 relative">
    <input id="credit-ledger-search" type="text" placeholder="Search by customer, phone number, invoice, or item summary..." value="<%= typeof search !== 'undefined' ? search : '' %>" class="w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 text-sm">
    <button type="button" id="credit-ledger-search-clear" class="absolute inset-y-0 right-10 flex items-center text-slate-400 hover:text-slate-600">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
  <div id="credit-ledger-pagination-top">
    <%- include("../components/pagination", { pagination, baseUrl: "/credit-ledger", search: typeof search !== 'undefined' ? search : '' }) %>
  </div>
  <div class="table-scroll overflow-x-auto">
    <table id="credit-ledger-table" class="responsive-table min-w-full text-left text-sm">
      <thead class="bg-slate-50 text-slate-600">
        <tr>
          <th class="px-4 py-3">Customer</th>
          <th class="px-4 py-3">Ledger Details</th>
          <th class="px-4 py-3">Balance Due</th>
          <th class="px-4 py-3">Source</th>
          <th class="px-4 py-3">Created By</th>
          <th class="px-4 py-3">Date</th>
        </tr>
      </thead>
      <tbody id="credit-ledger-tbody" class="divide-y divide-slate-200">
        <% if (entries.length) { entries.forEach((entry) => { %>
          <tr data-row class="hover:bg-slate-50">
            <td data-label="Customer" class="px-4 py-3 align-top">
              <div class="font-semibold text-slate-900"><%= entry.customer_name %></div>
              <div class="text-xs text-slate-500"><%= entry.customer_phone %></div>
            </td>
            <td data-label="Ledger Details" class="px-4 py-3 align-top">
              <div class="font-medium text-slate-800">Total: PHP <%= formatCurrency(entry.total_amount) %></div>
              <button
                type="button"
                class="open-credit-ledger-items-modal-button mt-2 rounded-xl border border-sky-200 px-3 py-2 text-xs font-semibold text-sky-700 transition hover:bg-sky-50"
                data-customer-name="<%= entry.customer_name %>"
                data-total-amount="<%= Number(entry.total_amount || 0).toFixed(2) %>"
                data-item-summary="<%= entry.item_summary || '' %>"
              >
                View Items
              </button>
            </td>
            <td data-label="Balance Due" class="px-4 py-3 align-top">
              <% if (Number(entry.balance_due || 0) > 0) { %>
                <span class="font-semibold text-violet-700">PHP <%= formatCurrency(entry.balance_due) %></span>
              <% } else { %>
                <div class="font-semibold text-emerald-700">PHP <%= formatCurrency(entry.balance_due) %></div>
                <div class="mt-1 text-xs text-slate-500">Paid / cleared</div>
              <% } %>
            </td>
            <td data-label="Source" class="px-4 py-3 align-top text-slate-600">
              <% if (entry.transaction_id) { %>
                <div class="font-medium"><%= formatInvoice(entry.transaction_id) %></div>
                <div class="text-xs text-slate-500">Transaction credit sale</div>
              <% } else { %>
                <div class="font-medium">Manual Entry</div>
                <div class="text-xs text-slate-500">Saved directly to ledger</div>
              <% } %>
            </td>
            <td data-label="Created By" class="px-4 py-3 align-top text-slate-500"><%= entry.created_by_username || "-" %></td>
            <td data-label="Date" class="px-4 py-3 align-top text-slate-500"><%= formatDateTime(entry.created_at) %></td>
          </tr>
        <% }) } else { %>
          <tr><td colspan="6" class="px-4 py-8 text-center text-slate-500">No credit ledger entries found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <div id="credit-ledger-pagination-bottom">
    <%- include("../components/pagination", { pagination, baseUrl: "/credit-ledger", search: typeof search !== 'undefined' ? search : '' }) %>
  </div>
  <p id="credit-ledger-empty-search" class="hidden p-6 text-center text-sm text-slate-500">No credit ledger entries found.</p>
</section>

<%- include("../components/modals/add-credit-ledger", { items, customers }) %>
<%- include("../components/modals/settle-credit-balance") %>
<%- include("../components/modals/credit-ledger-items") %>
<script>
  window.creditLedgerItemCatalog = <%- JSON.stringify(
    items.map((item) => ({
      barcode: String(item.barcode || ""),
      name: String(item.name || ""),
      price: Number(item.price || 0)
    }))
  ) %>;
</script>

<%- include("../includes/footer") %>
