<% /* Admin panel for managing dashboard users and roles. */ %>
<%- include("../includes/header", { title }) %>

<section class="mb-6 rounded-3xl bg-gradient-to-r from-slate-950 via-slate-800 to-sky-800 p-5 text-white shadow-soft sm:p-6">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-sky-200">Admin Panel</p>
      <h1 class="mt-2 text-2xl font-semibold sm:text-3xl">Manage dashboard access</h1>
      <p class="mt-2 max-w-2xl text-sm text-slate-200">Create users, define custom roles, and choose exactly which pages and actions each role can access.</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <% if (can('admin.data.manage')) { %>
        <a
          href="/admin/data/export"
          class="rounded-2xl border border-white/30 bg-white/10 px-4 py-3 text-sm font-semibold text-white transition hover:bg-white/20"
        >
          Export All Data
        </a>
        <button
          type="button"
          data-open-modal="manage-app-backup-modal"
          class="rounded-2xl border border-amber-300 bg-amber-400/15 px-4 py-3 text-sm font-semibold text-white transition hover:bg-amber-400/25"
        >
          Import All Data
        </button>
      <% } %>
      <% if (can('admin.roles.create')) { %>
        <button
          type="button"
          data-open-modal="add-role-modal"
          class="rounded-2xl border border-white/30 bg-white/10 px-4 py-3 text-sm font-semibold text-white transition hover:bg-white/20"
        >
          Add Role
        </button>
      <% } %>
      <% if (can('admin.users.create')) { %>
        <button
          type="button"
          data-open-modal="add-user-modal"
          class="rounded-2xl bg-white px-4 py-3 text-sm font-semibold text-slate-950 shadow-sm transition hover:bg-sky-50"
        >
          Add User
        </button>
      <% } %>
    </div>
  </div>
</section>

<section class="mb-6 grid gap-4 md:grid-cols-3">
  <article class="rounded-3xl bg-white p-5 shadow-soft">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Total Users</p>
    <p class="mt-3 text-3xl font-semibold text-slate-950"><%= summary.totalUsers %></p>
  </article>
  <article class="rounded-3xl bg-white p-5 shadow-soft">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Total Roles</p>
    <p class="mt-3 text-3xl font-semibold text-sky-700"><%= summary.totalRoles %></p>
  </article>
  <article class="rounded-3xl bg-white p-5 shadow-soft">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Custom Roles</p>
    <p class="mt-3 text-3xl font-semibold text-emerald-700"><%= summary.customRoles %></p>
  </article>
</section>

<% if (can('admin.data.manage')) { %>
<section class="mb-6 rounded-3xl bg-white p-5 shadow-soft sm:p-6">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <div>
      <h2 class="text-lg font-semibold text-slate-950">Full App Backup</h2>
      <p class="mt-1 text-sm text-slate-500">Export or restore all app data at once, including users, roles, inventory, customers, transactions, ledger records, adjustments, and activity logs.</p>
      <p class="mt-2 text-xs uppercase tracking-[0.18em] text-slate-400"><%= backupSummary.tableCount %> tables included</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a
        href="/admin/data/export"
        class="inline-flex items-center justify-center rounded-2xl bg-slate-950 px-4 py-3 text-sm font-semibold text-white transition hover:bg-slate-800"
      >
        Download Backup JSON
      </a>
      <button
        type="button"
        data-open-modal="manage-app-backup-modal"
        class="inline-flex items-center justify-center rounded-2xl border border-rose-300 px-4 py-3 text-sm font-semibold text-rose-700 transition hover:bg-rose-50"
      >
        Restore From Backup
      </button>
    </div>
  </div>
</section>
<% } %>

<% if (can('activity_logs.view')) { %>
<section class="mb-6 rounded-3xl bg-white p-5 shadow-soft sm:p-6">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <div>
      <h2 class="text-lg font-semibold text-slate-950">Audit Trail</h2>
      <p class="mt-1 text-sm text-slate-500">Open the full activity history to review logins, user management, inventory changes, exports, and transactions.</p>
    </div>
    <a
      href="/admin/activity-logs"
      class="inline-flex items-center justify-center rounded-2xl bg-emerald-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-emerald-700"
    >
      Open Activity Logs
    </a>
  </div>
</section>
<% } %>

<% if (can('admin.roles.view')) { %>
<section class="mb-6 rounded-3xl bg-white shadow-soft">
  <div class="border-b border-slate-200 px-5 py-4 sm:px-6">
    <h2 class="text-lg font-semibold text-slate-950">Roles</h2>
    <p class="mt-1 text-sm text-slate-500">Each role can be assigned to users and grants only the selected pages and actions.</p>
  </div>

  <div class="table-scroll overflow-x-auto">
    <table class="responsive-table min-w-full text-left text-sm">
      <thead class="bg-slate-50 text-slate-600">
        <tr>
          <th class="px-4 py-3">Role</th>
          <th class="px-4 py-3">Type</th>
          <th class="px-4 py-3">Permissions</th>
          <th class="px-4 py-3">Users</th>
          <th class="px-4 py-3">Created</th>
          <th class="px-4 py-3">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <% if (roles.length) { roles.forEach((managedRole) => { %>
          <tr class="hover:bg-slate-50">
            <td data-label="Role" class="px-4 py-3 font-medium text-slate-900">
              <div><%= managedRole.display_name %></div>
              <div class="text-xs text-slate-500"><%= managedRole.name %></div>
            </td>
            <td data-label="Type" class="px-4 py-3">
              <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold <%= Number(managedRole.is_system) ? 'bg-sky-100 text-sky-800' : 'bg-violet-100 text-violet-800' %>">
                <%= Number(managedRole.is_system) ? "System" : "Custom" %>
              </span>
            </td>
            <td data-label="Permissions" class="px-4 py-3 text-slate-500"><%= managedRole.permission_count %></td>
            <td data-label="Users" class="px-4 py-3 text-slate-500"><%= managedRole.user_count %></td>
            <td data-label="Created" class="px-4 py-3 text-slate-500"><%= formatDateTime(managedRole.created_at) %></td>
            <td data-label="Actions" class="px-4 py-3">
              <button
                type="button"
                data-open-modal="view-role-permissions-modal"
                data-view-role-permissions-trigger
                data-role-name="<%= managedRole.name %>"
                data-role-display-name="<%= managedRole.display_name %>"
                data-role-permissions="<%= managedRole.permission_keys || '' %>"
                class="w-full rounded-xl border border-sky-300 px-3 py-2 text-xs font-semibold text-sky-700 sm:w-auto"
              >
                View Permissions
              </button>
            </td>
          </tr>
        <% }) } else { %>
          <tr><td colspan="6" class="px-4 py-8 text-center text-slate-500">No roles found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
<% } %>

<% if (can('admin.users.view')) { %>
<section class="rounded-3xl bg-white shadow-soft">
  <div class="border-b border-slate-200 px-5 py-4 sm:px-6">
    <h2 class="text-lg font-semibold text-slate-950">User Accounts</h2>
    <p class="mt-1 text-sm text-slate-500">Assign each user to one role. Password reset stays available here for forgotten-password support.</p>
  </div>

  <div class="table-scroll overflow-x-auto">
    <table class="responsive-table min-w-full text-left text-sm">
      <thead class="bg-slate-50 text-slate-600">
        <tr>
          <th class="px-4 py-3">Username</th>
          <th class="px-4 py-3">Role</th>
          <th class="px-4 py-3">Created</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <% if (users.length) { users.forEach((managedUser) => { %>
          <tr class="hover:bg-slate-50">
            <td data-label="Username" class="px-4 py-3 font-medium text-slate-900">
              <div><%= managedUser.username %></div>
              <% if (user && Number(user.id) === Number(managedUser.id)) { %>
                <div class="mt-1 text-xs text-slate-500">Current session</div>
              <% } %>
            </td>
            <td data-label="Role" class="px-4 py-3">
              <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold <%= managedUser.role === 'cashier' ? 'bg-emerald-100 text-emerald-800' : managedUser.role === 'admin' ? 'bg-sky-100 text-sky-800' : 'bg-violet-100 text-violet-800' %>">
                <%= managedUser.role_display_name || managedUser.role %>
              </span>
            </td>
            <td data-label="Created" class="px-4 py-3 text-slate-500"><%= formatDateTime(managedUser.created_at) %></td>
            <td data-label="Status" class="px-4 py-3 text-slate-500">Active</td>
            <td data-label="Actions" class="px-4 py-3">
              <% if (can('admin.users.reset_password')) { %>
              <button
                type="button"
                data-open-modal="reset-user-password-modal"
                data-reset-password-trigger
                data-user-id="<%= managedUser.id %>"
                data-username="<%= managedUser.username %>"
                class="w-full rounded-xl border border-amber-300 px-3 py-2 text-xs font-semibold text-amber-700 sm:w-auto"
              >
                Reset Password
              </button>
              <% } else { %>
                <span class="text-xs text-slate-400">No actions</span>
              <% } %>
            </td>
          </tr>
        <% }) } else { %>
          <tr>
            <td colspan="5" class="px-4 py-8 text-center text-slate-500">No users found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
<% } %>

<% if (can('admin.users.create')) { %>
  <%- include("../components/modals/add-user", { roles }) %>
<% } %>
<% if (can('admin.roles.create')) { %>
  <%- include("../components/modals/add-role", { permissionGroups }) %>
<% } %>
<% if (can('admin.roles.view')) { %>
  <%- include("../components/modals/view-role-permissions") %>
  <script id="permission-catalog" type="application/json"><%- JSON.stringify(permissionGroups) %></script>
<% } %>
<% if (can('admin.users.reset_password')) { %>
  <%- include("../components/modals/reset-user-password") %>
<% } %>
<% if (can('admin.data.manage')) { %>
  <%- include("../components/modals/manage-app-backup") %>
<% } %>

<%- include("../includes/footer") %>
