<% /* Detailed inventory item page used for read-only item review. */ %>
<%- include("../includes/header", { title }) %>

<section class="mx-auto max-w-5xl space-y-6">
  <div class="rounded-3xl bg-white p-6 shadow-soft">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-sky-600">View Item</p>
    <h1 class="mt-2 text-3xl font-semibold"><%= item.name %></h1>
    <p class="mt-2 text-sm text-slate-500">Item details are view-only on this page.</p>
  </div>

  <section class="rounded-3xl bg-white p-6 shadow-soft">
    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <p class="mb-2 text-sm font-medium text-slate-700">Item Number</p>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"><%= item.barcode %></div>
      </div>

      <div>
        <p class="mb-2 text-sm font-medium text-slate-700">Item Name</p>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"><%= item.name %></div>
      </div>

      <div>
        <p class="mb-2 text-sm font-medium text-slate-700">Cost</p>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm">PHP <%= formatCurrency(item.cost) %></div>
      </div>

      <div>
        <p class="mb-2 text-sm font-medium text-slate-700">Price</p>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm">PHP <%= formatCurrency(item.price) %></div>
      </div>

      <div>
        <p class="mb-2 text-sm font-medium text-slate-700">OH Qty</p>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"><%= item.quantity %></div>
      </div>

      <div>
        <p class="mb-2 text-sm font-medium text-slate-700">Min Quantity</p>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"><%= item.min_quantity %></div>
      </div>

      <div>
        <p class="mb-2 text-sm font-medium text-slate-700">Max Quantity</p>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"><%= item.max_quantity %></div>
      </div>

      <div>
        <p class="mb-2 text-sm font-medium text-slate-700">Category</p>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"><%= item.category_name || "No Category" %></div>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/inventory/adjustments" class="rounded-2xl bg-amber-500 px-4 py-3 text-sm font-semibold text-slate-950">Open Adjustments</a>
      <a href="/inventory" class="rounded-2xl border px-4 py-3 text-sm font-semibold text-slate-700">Back to Inventory</a>
    </div>
  </section>
</section>

<%- include("../includes/footer") %>