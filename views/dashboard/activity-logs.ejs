<% /* Admin audit-trail page for recent actions across the app. */ %>
<%- include("../includes/header", { title }) %>

<section class="mb-6 rounded-3xl bg-gradient-to-r from-slate-950 via-slate-800 to-emerald-700 p-5 text-white shadow-soft sm:p-6">
  <p class="text-xs font-semibold uppercase tracking-[0.25em] text-emerald-100">Activity Logs</p>
  <h1 class="mt-2 text-2xl font-semibold sm:text-3xl">Recent app activity</h1>
  <p class="mt-2 max-w-2xl text-sm text-slate-200">This audit trail shows recent write actions and session events across the dashboard.</p>
</section>

<section class="mb-6 rounded-3xl bg-white p-5 shadow-soft sm:p-6">
  <form action="/admin/activity-logs" method="GET" class="grid gap-4 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)_minmax(0,1fr)_auto]">
    <div>
      <label for="activity-search" class="mb-2 block text-sm font-medium text-slate-700">Search</label>
      <input
        id="activity-search"
        type="text"
        name="search"
        value="<%= selectedFilters.search %>"
        placeholder="Search by details, entity, or id..."
        class="w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 text-sm"
      >
    </div>

    <div>
      <label for="activity-action" class="mb-2 block text-sm font-medium text-slate-700">Action</label>
      <select
        id="activity-action"
        name="action"
        class="w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 text-sm"
      >
        <option value="">All actions</option>
        <% availableActions.forEach((availableAction) => { %>
          <option value="<%= availableAction %>" <%= selectedFilters.action === availableAction ? "selected" : "" %>><%= availableAction %></option>
        <% }) %>
      </select>
    </div>

    <div>
      <label for="activity-username" class="mb-2 block text-sm font-medium text-slate-700">User</label>
      <select
        id="activity-username"
        name="username"
        class="w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 text-sm"
      >
        <option value="">All users</option>
        <% availableUsers.forEach((availableUser) => { %>
          <option value="<%= availableUser %>" <%= selectedFilters.username === availableUser ? "selected" : "" %>><%= availableUser %></option>
        <% }) %>
      </select>
    </div>

    <div class="flex items-end gap-3">
      <button type="submit" class="rounded-2xl bg-slate-950 px-4 py-3 text-sm font-semibold text-white">Apply</button>
      <a href="/admin/activity-logs" class="rounded-2xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700">Reset</a>
    </div>
  </form>
</section>

<section class="rounded-3xl bg-white shadow-soft">
  <div class="border-b border-slate-200 px-5 py-4 sm:px-6">
    <h2 class="text-lg font-semibold text-slate-950">Latest 300 Entries</h2>
    <p class="mt-1 text-sm text-slate-500">Newest records appear first. Filters above narrow the results before the 300-row limit is applied.</p>
  </div>

  <div class="table-scroll overflow-x-auto">
    <table class="responsive-table min-w-full text-left text-sm">
      <thead class="bg-slate-50 text-slate-600">
        <tr>
          <th class="px-4 py-3">When</th>
          <th class="px-4 py-3">User</th>
          <th class="px-4 py-3">Action</th>
          <th class="px-4 py-3">Entity</th>
          <th class="px-4 py-3">Details</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <% if (activities.length) { activities.forEach((activity) => { %>
          <tr class="hover:bg-slate-50">
            <td data-label="When" class="px-4 py-3 text-slate-500"><%= formatDateTime(activity.created_at) %></td>
            <td data-label="User" class="px-4 py-3">
              <div class="font-medium text-slate-900"><%= activity.username_snapshot || "-" %></div>
              <div class="text-xs text-slate-500"><%= activity.role_snapshot || "-" %></div>
            </td>
            <td data-label="Action" class="px-4 py-3">
              <span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700"><%= activity.action %></span>
            </td>
            <td data-label="Entity" class="px-4 py-3 text-slate-500">
              <div><%= activity.entity_type || "-" %></div>
              <div class="text-xs"><%= activity.entity_id || "-" %></div>
            </td>
            <td data-label="Details" class="px-4 py-3 text-slate-700"><%= activity.description %></td>
          </tr>
        <% }) } else { %>
          <tr>
            <td colspan="5" class="px-4 py-8 text-center text-slate-500">No activity logs found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<%- include("../includes/footer") %>
