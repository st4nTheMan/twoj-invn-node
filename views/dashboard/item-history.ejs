<% /* Item history hub page with links to each history category. */ %>
<%- include("../includes/header", { title }) %>

<section class="mx-auto max-w-5xl space-y-6">
  <div class="rounded-3xl bg-white p-6 shadow-soft">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-600">History</p>
    <h1 class="mt-2 text-3xl font-semibold"><%= item.name %></h1>
    <p class="mt-2 text-sm text-slate-500">Item number: <span class="font-medium text-slate-700"><%= item.barcode %></span></p>
    <p class="mt-1 text-sm text-slate-500">Choose which history page you want to review for this item.</p>
  </div>

  <section class="rounded-3xl bg-white p-6 shadow-soft">
    <div class="grid gap-4 sm:grid-cols-2">
      <a href="/inventory/items/<%= item.id %>/quantity" class="rounded-3xl border border-sky-200 bg-sky-50 px-5 py-5 transition hover:bg-sky-100">
        <p class="text-sm font-semibold text-sky-700">OH Qty History</p>
        <p class="mt-2 text-sm text-slate-600">Review changes to the on-hand quantity.</p>
      </a>

      <a href="/inventory/items/<%= item.id %>/min-max" class="rounded-3xl border border-indigo-200 bg-indigo-50 px-5 py-5 transition hover:bg-indigo-100">
        <p class="text-sm font-semibold text-indigo-700">Min/Max Qty History</p>
        <p class="mt-2 text-sm text-slate-600">Review updates to minimum and maximum stock levels.</p>
      </a>

      <a href="/inventory/items/<%= item.id %>/cost" class="rounded-3xl border border-emerald-200 bg-emerald-50 px-5 py-5 transition hover:bg-emerald-100">
        <p class="text-sm font-semibold text-emerald-700">Cost History</p>
        <p class="mt-2 text-sm text-slate-600">Review item cost changes over time.</p>
      </a>

      <a href="/inventory/items/<%= item.id %>/price" class="rounded-3xl border border-amber-200 bg-amber-50 px-5 py-5 transition hover:bg-amber-100">
        <p class="text-sm font-semibold text-amber-700">Price History</p>
        <p class="mt-2 text-sm text-slate-600">Review selling price changes over time.</p>
      </a>

      <a href="/inventory/items/<%= item.id %>/category" class="rounded-3xl border border-violet-200 bg-violet-50 px-5 py-5 transition hover:bg-violet-100">
        <p class="text-sm font-semibold text-violet-700">Category History</p>
        <p class="mt-2 text-sm text-slate-600">Review category changes and their notes.</p>
      </a>
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/history" class="rounded-2xl border px-4 py-3 text-sm font-semibold text-slate-700">Back to History</a>
      <a href="/inventory/items/<%= item.id %>" class="rounded-2xl border px-4 py-3 text-sm font-semibold text-slate-700">Back to Item</a>
    </div>
  </section>
</section>

<%- include("../includes/footer") %>
