<% /* Main inventory dashboard page with item table and inventory modals. */ %>
<%- include("../includes/header", { title }) %>

<section class="mb-6 rounded-3xl bg-white p-5 shadow-soft sm:p-6">
  <p class="text-xs font-semibold uppercase tracking-[0.25em] text-sky-600">Inventory</p>
  <h1 class="mt-2 text-2xl font-semibold sm:text-3xl">Stock overview</h1>
</section>

<section class="mb-6 rounded-3xl bg-white p-5 shadow-soft">
  <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
    <% if (can('inventory.create')) { %>
      <button
        type="button"
        data-open-modal="add-item-modal"
        class="w-full rounded-2xl bg-sky-600 px-4 py-3 text-sm font-semibold text-white sm:w-auto"
      >
        Add Item
      </button>
    <% } %>

    <% if (can('inventory.create')) { %>
      <button
        type="button"
        data-open-modal="add-category-modal"
        class="w-full rounded-2xl bg-emerald-500 px-4 py-3 text-sm font-semibold text-white sm:w-auto"
      >
        Add Category
      </button>
    <% } %>

    <% if (can('inventory.export')) { %>
      <button
        type="button"
        data-open-modal="export-inventory-modal"
        class="w-full rounded-2xl bg-slate-950 px-4 py-3 text-sm font-semibold text-white sm:w-auto"
      >
        Export
      </button>
    <% } %>

    <% if (can('inventory.archive_restore')) { %>
      <button
        type="button"
        data-open-modal="archived-items-modal"
        class="w-full rounded-2xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700 sm:w-auto"
      >
        Archived Items
      </button>
    <% } %>

    <% if (!canAny(['inventory.create', 'inventory.export', 'inventory.archive_restore'])) { %>
      <p class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600">
        Your role can view stock here. Management actions only appear when the role has permission.
      </p>
    <% } %>
  </div>
</section>

<section class="mb-6 rounded-3xl bg-white p-5 shadow-soft">
  <div class="flex gap-2">
    <div class="relative flex-1">
      <input
        id="inventory-search"
        type="text"
        placeholder="Search by name, number, or category..."
        value="<%= typeof search !== 'undefined' ? search : '' %>"
        class="w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 pr-12 text-sm"
      >
      <button type="button" id="search-clear" class="absolute inset-y-0 right-5 flex items-center text-slate-400 hover:text-slate-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>
</section>

<%- include("../components/filter-sort-bar", {
  tableId: "inventory-table",
  selectedSort,
  sortOptions: [
    { value: "newest",      label: "Newest first" },
    { value: "oldest",      label: "Oldest first" },
    { value: "name_asc",    label: "Name A–Z" },
    { value: "name_desc",   label: "Name Z–A" },
    { value: "barcode_asc", label: "Item No. A–Z" },
    { value: "barcode_desc",label: "Item No. Z–A" },
    { value: "price_asc",   label: "Price low–high" },
    { value: "price_desc",  label: "Price high–low" }
  ],
  filterName: "category",
  filterLabel: "Category",
  filterOptions: categories.map((c) => ({ value: c.id, label: c.category_name })),
  selectedFilter: selectedCategory
}) %>

<section class="table-scroll mb-6 overflow-x-auto rounded-3xl bg-white shadow-soft">
  <div id="inventory-pagination-top">
    <%- include("../components/pagination", { pagination, baseUrl: "/inventory", search, extras: { category: selectedCategory, sort: selectedSort } }) %>
  </div>

  <table id="inventory-table" class="responsive-table min-w-full text-left text-sm">
    <thead class="bg-slate-50 text-slate-600">
      <tr>
        <th class="px-4 py-3">Item Number</th>
        <th class="px-4 py-3">Name</th>
        <th class="px-4 py-3">Price</th>
        <th class="px-4 py-3">Qty</th>
        <th class="px-4 py-3">Category</th>
        <th class="px-4 py-3">Created By</th>
        <th class="px-4 py-3">Created Datetime</th>
        <th class="px-4 py-3">Actions</th>
      </tr>
    </thead>
    <tbody id="inventory-tbody" class="divide-y divide-slate-200">
      <% if (items.length) { items.forEach((item) => { %>
        <tr data-row class="hover:bg-slate-50">
          <td data-label="Item Number" class="px-4 py-3 font-medium"><%= item.barcode %></td>
          <td data-label="Name" class="px-4 py-3"><%= item.name %></td>
          <td data-label="Price" class="px-4 py-3">PHP <%= formatCurrency(item.price) %></td>
          <td data-label="Qty" class="px-4 py-3"><%= item.quantity %></td>
          <td data-label="Category" class="px-4 py-3"><%= item.category_name || "No Category" %></td>
          <td data-label="Created By" class="px-4 py-3 text-slate-500"><%= item.created_by_username || "-" %></td>
          <td data-label="Created" class="px-4 py-3 text-slate-500"><%= formatDateTime(item.created_at) %></td>
          <td data-label="Actions" class="px-4 py-3">
            <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap">
              <button
                type="button"
                data-open-modal="view-item-modal"
                data-view-item-trigger
                data-item-id="<%= item.id %>"
                data-item-barcode="<%= item.barcode %>"
                data-item-name="<%= item.name %>"
                data-item-cost="<%= item.cost %>"
                data-item-price="<%= item.price %>"
                data-item-quantity="<%= item.quantity %>"
                data-item-min-quantity="<%= item.min_quantity %>"
                data-item-max-quantity="<%= item.max_quantity %>"
                data-item-category="<%= item.category_name || 'No Category' %>"
                data-item-created-by="<%= item.created_by_username || '-' %>"
                data-item-updated-by="<%= item.updated_by_username || '-' %>"
                class="rounded-xl border border-sky-300 px-3 py-2 text-center text-xs font-semibold text-sky-700"
              >
                View Item
              </button>
            </div>
          </td>
        </tr>
      <% }) } else { %>
        <tr><td colspan="8" class="px-4 py-8 text-center text-slate-500">No items found.</td></tr>
      <% } %>
    </tbody>
  </table>

  <div id="inventory-pagination-bottom">
    <%- include("../components/pagination", { pagination, baseUrl: "/inventory", search: typeof search !== 'undefined' ? search : '' }) %>
  </div>
  <p id="inventory-empty-search" class="hidden p-6 text-center text-sm text-slate-500">No items found.</p>
</section>

<%- include("../components/modals/view-item") %>
<% if (can('inventory.create')) { %>
  <%- include("../components/modals/add-item", { categories }) %>
  <%- include("../components/modals/barcode-scanner", {
    scannerMessage: "Point the camera at the barcode to fill the item number automatically.",
    enableBarcodeUpload: true,
    scannerHint: "You can scan with the camera or upload a clear barcode photo from your device."
  }) %>
  <%- include("../components/modals/add-category", { categories }) %>
<% } %>
<% if (can('inventory.archive_restore')) { %>
  <%- include("../components/modals/archive-item-confirm") %>
  <%- include("../components/modals/archived-items", { archivedItems }) %>
<% } %>
<% if (can('inventory.export')) { %>
  <%- include("../components/modals/export-inventory") %>
<% } %>

<%- include("../includes/footer") %>
