<% /* Checkout page for building and submitting item transactions. */ %>
<%- include("../includes/header", { title }) %>

<section class="mb-6 rounded-3xl bg-slate-950 p-5 text-white shadow-soft sm:p-6">
  <p class="text-xs font-semibold uppercase tracking-[0.25em] text-sky-300">Transaction</p>
  <h1 class="mt-2 text-2xl font-semibold sm:text-3xl">Build a checkout from live stock.</h1>
</section>

<section class="grid gap-6 xl:grid-cols-[1.4fr_1fr]">
  <div class="order-2 rounded-3xl bg-white shadow-soft xl:order-1">
    <div class="border-b border-slate-200 p-5 relative">
      <input id="transaction-search" type="text" placeholder="Search by number, name, or category..." data-hide-until-search="true" class="w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 text-sm">
      <button type="button" id="search-clear" class="absolute inset-y-0 right-10 flex items-center text-slate-400 hover:text-slate-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
    <div class="table-scroll overflow-x-auto">
      <table id="transaction-table" class="responsive-table min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-slate-600">
          <tr>
            <th class="px-4 py-3">Item Number</th>
            <th class="px-4 py-3">Name</th>
            <th class="px-4 py-3">Price</th>
            <th class="px-4 py-3">Category</th>
            <th class="px-4 py-3">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% items.forEach((item) => { %>
            <tr data-row class="hover:bg-slate-50">
              <td data-label="Item Number" class="px-4 py-3 font-medium"><%= item.barcode %></td>
              <td data-label="Name" class="px-4 py-3"><%= item.name %></td>
              <td data-label="Price" class="px-4 py-3">PHP <%= formatCurrency(item.price) %></td>
              <td data-label="Category" class="px-4 py-3"><%= item.category_name || "No Category" %></td>
              <td data-label="Action" class="px-4 py-3">
                <button type="button" class="add-transaction-item-button w-full rounded-xl bg-sky-600 px-3 py-2 text-xs font-semibold text-white sm:w-auto" 
                  data-id="<%= item.id %>"
                  data-barcode="<%= item.barcode %>"
                  data-name="<%= item.name %>"
                  data-price="<%= item.price %>"
                  data-stock="<%= item.quantity %>"
                >
                  Select
                </button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p id="transaction-empty-search" class="hidden p-6 text-center text-sm text-slate-500">Search for an item number, name, or category to view results.</p>
  </div>

  <form id="transaction-form" action="/transaction" method="POST" class="order-1 rounded-3xl bg-white p-6 shadow-soft xl:order-2">
    <h2 class="text-xl font-semibold">Selected Items</h2>
    <div class="table-scroll mt-4 overflow-x-auto">
      <table class="responsive-table min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-slate-600">
          <tr><th class="px-4 py-3">Item</th><th class="px-4 py-3">Price</th><th class="px-4 py-3">Qty</th><th class="px-4 py-3">Subtotal</th><th class="px-4 py-3">Remove</th></tr>
        </thead>
        <tbody id="selected-items-body">
          <tr id="no-selected-items-row"><td colspan="5" class="px-4 py-8 text-center text-sm text-slate-500">No items selected.</td></tr>
        </tbody>
      </table>
    </div>
    <div class="mt-4 rounded-2xl bg-slate-950 px-4 py-4 text-right text-white">PHP <span id="transaction-total">0.00</span></div>
    <button id="open-payment-modal-button" type="submit" class="mt-4 w-full rounded-2xl bg-emerald-500 px-4 py-3 text-sm font-semibold text-white">Complete Transaction</button>
  </form>
</section>

<%- include("../components/modals/out-of-stock") %>
<%- include("../components/modals/transaction-payment") %>

<%- include("../includes/footer") %>
