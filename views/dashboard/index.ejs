<% /* Post-login operations dashboard with sales, stock, ledger, and shortcuts. */ %>
<%- include("../includes/header", { title }) %>

<section class="mb-6 rounded-3xl bg-slate-950 p-5 text-white shadow-soft sm:p-6">
  <p class="text-xs font-semibold uppercase tracking-[0.25em] text-sky-300">Dashboard</p>
  <div class="mt-2 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-2xl font-semibold sm:text-3xl">Good day, <%= user.username %>.</h1>
      <p class="mt-1 text-sm text-slate-300">Store overview for <%= todayDate %></p>
    </div>
    <button
      type="button"
      data-open-modal="stock-notifications-modal"
      class="rounded-2xl border border-slate-700 px-4 py-3 text-sm font-semibold text-slate-100 transition hover:border-sky-400"
    >
      Stock Notifications
      <% if (notifications.count > 0) { %>
        <span class="ml-2 rounded-full bg-rose-500 px-2 py-0.5 text-xs text-white"><%= notifications.count %></span>
      <% } %>
    </button>
  </div>
</section>

<section class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <article class="rounded-3xl bg-white p-5 shadow-soft">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Sales Today</p>
    <p class="mt-3 text-2xl font-semibold">PHP <%= formatCurrency(todaySnapshot.total_sales) %></p>
    <p class="mt-1 text-sm text-slate-500"><%= Number(todaySnapshot.transaction_count || 0) %> transactions</p>
  </article>
  <article class="rounded-3xl bg-white p-5 shadow-soft">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Cash Sales</p>
    <p class="mt-3 text-2xl font-semibold text-emerald-600">PHP <%= formatCurrency(todaySnapshot.cash_sales) %></p>
    <p class="mt-1 text-sm text-slate-500">Collected as cash</p>
  </article>
  <article class="rounded-3xl bg-white p-5 shadow-soft">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Credit Sales</p>
    <p class="mt-3 text-2xl font-semibold text-violet-600">PHP <%= formatCurrency(todaySnapshot.credit_sales) %></p>
    <p class="mt-1 text-sm text-slate-500">Recorded to ledger</p>
  </article>
  <article class="rounded-3xl bg-white p-5 shadow-soft">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Balance Due</p>
    <p class="mt-3 text-2xl font-semibold text-rose-600">PHP <%= formatCurrency(creditSummary.total_balance_due) %></p>
    <p class="mt-1 text-sm text-slate-500"><%= Number(creditSummary.unpaid_entry_count || 0) %> unpaid entries</p>
  </article>
</section>

<section class="mb-6 grid gap-6 xl:grid-cols-[1.2fr_0.8fr]">
  <div class="rounded-3xl bg-white shadow-soft">
    <div class="flex items-center justify-between gap-3 border-b border-slate-200 p-5">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Recent Transactions</p>
        <h2 class="mt-1 text-xl font-semibold">Latest sales</h2>
      </div>
      <% if (can('reports.view')) { %>
        <a href="/reports" class="rounded-2xl border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-sky-400 hover:text-sky-700">View Reports</a>
      <% } %>
    </div>

    <div class="table-scroll overflow-x-auto">
      <table class="responsive-table min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-slate-600">
          <tr>
            <th class="px-4 py-3">Invoice</th>
            <th class="px-4 py-3">Payment</th>
            <th class="px-4 py-3">Total</th>
            <th class="px-4 py-3">By</th>
            <th class="px-4 py-3">Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% if (recentTransactions.length) { recentTransactions.forEach((transaction) => { %>
            <tr class="hover:bg-slate-50">
              <td data-label="Invoice" class="px-4 py-3 font-medium"><%= formatInvoice(transaction.id) %></td>
              <td data-label="Payment" class="px-4 py-3 capitalize"><%= transaction.payment_method %></td>
              <td data-label="Total" class="px-4 py-3">PHP <%= formatCurrency(transaction.total_amount) %></td>
              <td data-label="By" class="px-4 py-3 text-slate-500"><%= transaction.created_by_username || "-" %></td>
              <td data-label="Date" class="px-4 py-3 text-slate-500"><%= formatDateTime(transaction.created_at) %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="5" class="px-4 py-8 text-center text-slate-500">No transactions yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="rounded-3xl bg-white p-5 shadow-soft">
    <div class="flex items-center justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Inventory Alerts</p>
        <h2 class="mt-1 text-xl font-semibold">Needs attention</h2>
      </div>
      <% if (can('inventory.view')) { %>
        <a href="/inventory" class="rounded-2xl border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-sky-400 hover:text-sky-700">Inventory</a>
      <% } %>
    </div>

    <div class="mt-4 space-y-3">
      <% if (inventoryAlerts.length) { inventoryAlerts.forEach((item) => { %>
        <div class="rounded-2xl border border-rose-100 bg-rose-50 p-4">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="font-semibold text-slate-900"><%= item.name %></p>
              <p class="mt-1 text-xs text-slate-500"><%= item.barcode %> <%= item.category_name ? `- ${item.category_name}` : "" %></p>
            </div>
            <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-rose-700">Qty <%= item.quantity %></span>
          </div>
          <p class="mt-2 text-xs text-rose-700">Minimum: <%= item.min_quantity %></p>
        </div>
      <% }) } else { %>
        <p class="rounded-2xl border border-emerald-100 bg-emerald-50 p-4 text-sm text-emerald-700">No low-stock items right now.</p>
      <% } %>
    </div>
  </div>
</section>

<section class="grid gap-6 lg:grid-cols-2">
  <div class="rounded-3xl bg-white p-5 shadow-soft">
    <div class="flex items-center justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Credit Summary</p>
        <h2 class="mt-1 text-xl font-semibold">Ledger position</h2>
      </div>
      <% if (can('credit_ledger.view')) { %>
        <a href="/credit-ledger" class="rounded-2xl border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-violet-400 hover:text-violet-700">Open Ledger</a>
      <% } %>
    </div>
    <dl class="mt-5 grid gap-3 sm:grid-cols-2">
      <div class="rounded-2xl bg-slate-50 p-4">
        <dt class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Total Credit</dt>
        <dd class="mt-2 text-xl font-semibold">PHP <%= formatCurrency(creditSummary.total_credit) %></dd>
      </div>
      <div class="rounded-2xl bg-slate-50 p-4">
        <dt class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Customers</dt>
        <dd class="mt-2 text-xl font-semibold"><%= Number(creditSummary.customer_count || 0) %></dd>
      </div>
      <div class="rounded-2xl bg-slate-50 p-4">
        <dt class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Entries</dt>
        <dd class="mt-2 text-xl font-semibold"><%= Number(creditSummary.entry_count || 0) %></dd>
      </div>
      <div class="rounded-2xl bg-slate-50 p-4">
        <dt class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Unpaid</dt>
        <dd class="mt-2 text-xl font-semibold text-rose-600"><%= Number(creditSummary.unpaid_entry_count || 0) %></dd>
      </div>
    </dl>
  </div>

  <div class="rounded-3xl bg-white p-5 shadow-soft">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Fast Actions</p>
    <h2 class="mt-1 text-xl font-semibold">Jump back into work</h2>
    <div class="mt-5 grid gap-3 sm:grid-cols-2">
      <% if (can('transaction.create')) { %>
        <a href="/transaction" class="rounded-2xl bg-emerald-500 px-4 py-3 text-center text-sm font-semibold text-white transition hover:bg-emerald-600">New Transaction</a>
      <% } %>
      <% if (can('price_lookup.view')) { %>
        <a href="/price-lookup" class="rounded-2xl bg-amber-400 px-4 py-3 text-center text-sm font-semibold text-slate-950 transition hover:bg-amber-500">Price Lookup</a>
      <% } %>
      <% if (can('inventory.create')) { %>
        <a href="/inventory" class="rounded-2xl bg-sky-600 px-4 py-3 text-center text-sm font-semibold text-white transition hover:bg-sky-700">Add Item</a>
      <% } %>
      <% if (can('inventory.adjust')) { %>
        <a href="/inventory/adjustments" class="rounded-2xl bg-slate-950 px-4 py-3 text-center text-sm font-semibold text-white transition hover:bg-slate-800">Adjust Stock</a>
      <% } %>
      <% if (can('credit_ledger.create')) { %>
        <a href="/credit-ledger" class="rounded-2xl bg-violet-500 px-4 py-3 text-center text-sm font-semibold text-white transition hover:bg-violet-600">Add Credit</a>
      <% } %>
      <% if (can('reports.view')) { %>
        <a href="/reports" class="rounded-2xl border border-slate-300 px-4 py-3 text-center text-sm font-semibold text-slate-700 transition hover:border-sky-400 hover:text-sky-700">Reports</a>
      <% } %>
      <% if (!canAny(['transaction.create', 'price_lookup.view', 'inventory.create', 'inventory.adjust', 'credit_ledger.create', 'reports.view'])) { %>
        <p class="rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600 sm:col-span-2">No quick actions are available for this role.</p>
      <% } %>
    </div>
  </div>
</section>

<%- include("../includes/footer") %>
