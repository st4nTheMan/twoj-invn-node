<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Inventory System</title>
  <script>
    tailwind = {
      config: {
        theme: {
          extend: {
            colors: {
              brand: {
                50: "#eff6ff",
                100: "#dbeafe",
                500: "#0ea5e9",
                600: "#0284c7",
                700: "#0369a1",
                900: "#0f172a"
              }
            },
            boxShadow: {
              soft: "0 20px 40px rgba(15, 23, 42, 0.08)"
            }
          }
        }
      }
    };
  </script>
  <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
  <link rel="stylesheet" href="/public/css/app.css">
</head>
<body class="min-h-screen bg-slate-100 text-slate-900">
  <% if (user) { %>
    <header class="border-b border-slate-200 bg-slate-950 text-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-4 sm:px-6 lg:px-8">
        <div>
          <a href="/inventory" class="text-lg font-semibold tracking-wide text-white">Inventory System</a>
          <p class="text-xs text-slate-400">Stock control, checkout, and sales reporting</p>
        </div>

        <nav class="flex items-center gap-2 text-sm font-medium">
          <a href="/inventory" class="rounded-full px-4 py-2 transition <%= currentPath.startsWith('/inventory') && !currentPath.includes('/price') ? 'bg-sky-500 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">Inventory</a>
          <a href="/transaction" class="rounded-full px-4 py-2 transition <%= currentPath === '/transaction' ? 'bg-emerald-500 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">Transaction</a>
          <a href="/reports" class="rounded-full px-4 py-2 transition <%= currentPath === '/reports' ? 'bg-amber-500 text-slate-950' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">Reports</a>
          <button type="button" data-open-modal="stock-notifications-modal" class="relative rounded-full border border-slate-700 p-2 text-slate-200 transition hover:border-sky-400 hover:text-white">
            <span class="sr-only">Open stock notifications</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10 2a4 4 0 00-4 4v1.586L5.293 8.293A1 1 0 005 9v3l-1 2v1h12v-1l-1-2V9a1 1 0 00-.293-.707L14 7.586V6a4 4 0 00-4-4zm0 16a2 2 0 001.995-1.85L12 16H8a2 2 0 002 2z"/>
            </svg>
            <% if (notifications.count > 0) { %>
              <span class="absolute -right-1 -top-1 inline-flex min-h-5 min-w-5 items-center justify-center rounded-full bg-rose-500 px-1.5 text-xs font-bold text-white"><%= notifications.count %></span>
            <% } %>
          </button>
          <a href="/logout" class="rounded-full border border-slate-700 px-4 py-2 text-slate-300 transition hover:border-rose-400 hover:text-white">Logout</a>
        </nav>
      </div>
    </header>
  <% } %>

  <main class="<%= user ? 'mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8' : '' %>">
    <% if (flash) { %>
      <div class="mb-6 rounded-2xl border px-4 py-3 shadow-soft <%= flash.type === 'success' ? 'border-emerald-200 bg-emerald-50 text-emerald-900' : 'border-rose-200 bg-rose-50 text-rose-900' %>">
        <p class="text-sm font-medium"><%= flash.message %></p>
      </div>
    <% } %>
