<% /* Modal for importing a full application backup JSON file. */ %>
<section id="manage-app-backup-modal" data-modal class="hidden fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-slate-950/60 p-4 sm:p-6">
  <div class="my-8 w-full max-w-3xl rounded-3xl bg-white shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
      <div>
        <h2 class="text-xl font-semibold text-slate-900">Import Full App Backup</h2>
        <p class="text-sm text-slate-500">Restore all app tables from one JSON backup export.</p>
      </div>
      <button type="button" data-close-modal class="rounded-full border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100">
        Close
      </button>
    </div>

    <form id="manage-app-backup-form" action="/admin/data/import" method="POST" class="space-y-5 p-6">
      <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
        Import replaces the current data across the app, including users, roles, inventory, sales, credit ledger, reports data, and activity logs.
      </div>

      <div class="space-y-2">
        <label for="app-backup-file" class="text-sm font-semibold text-slate-700">Backup File</label>
        <input id="app-backup-file" type="file" accept=".json,application/json" class="block w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm">
        <p id="app-backup-file-status" class="text-xs text-slate-500">Choose a JSON backup file exported from the admin panel, or paste the backup text below.</p>
      </div>

      <div class="space-y-2">
        <label for="app-backup-json-visible" class="text-sm font-semibold text-slate-700">Backup JSON</label>
        <textarea id="app-backup-json-visible" rows="12" class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm font-mono text-slate-800" placeholder="{&#10;  &quot;format&quot;: &quot;full-app-backup&quot;,&#10;  ...&#10;}"></textarea>
        <textarea id="app-backup-json" name="backup_json" class="hidden"></textarea>
      </div>

      <div class="flex justify-end gap-3">
        <button type="button" data-close-modal class="rounded-2xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700">Cancel</button>
        <button type="submit" class="rounded-2xl bg-rose-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-rose-700">
          Import Backup
        </button>
      </div>
    </form>
  </div>
</section>
