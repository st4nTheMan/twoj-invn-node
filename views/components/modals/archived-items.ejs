<% /* Modal for viewing and restoring archived inventory items. */ %>
<section id="archived-items-modal" data-modal class="hidden fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-slate-950/60 p-4 sm:p-6">
  <div class="my-8 w-full max-w-5xl rounded-3xl bg-white shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
      <div>
        <h2 class="text-xl font-semibold text-slate-900">Archived Items</h2>
        <p class="text-sm text-slate-500">Restore archived items back into active inventory.</p>
      </div>
      <button
        type="button"
        data-close-modal
        class="rounded-full border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100"
      >
        Close
      </button>
    </div>

    <div class="table-scroll overflow-x-auto">
      <table class="responsive-table min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-slate-600">
          <tr>
            <th class="px-4 py-3">Item Number</th>
            <th class="px-4 py-3">Name</th>
            <th class="px-4 py-3">Category</th>
            <th class="px-4 py-3">Created By</th>
            <th class="px-4 py-3">Archived</th>
            <th class="px-4 py-3">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% if (archivedItems?.length) { archivedItems.forEach((item) => { %>
            <tr class="hover:bg-slate-50">
              <td data-label="Item Number" class="px-4 py-3 font-medium"><%= item.barcode %></td>
              <td data-label="Name" class="px-4 py-3"><%= item.name %></td>
              <td data-label="Category" class="px-4 py-3"><%= item.category_name || "No Category" %></td>
              <td data-label="Created By" class="px-4 py-3 text-slate-500"><%= item.created_by_username || "-" %></td>
              <td data-label="Archived" class="px-4 py-3 text-slate-500"><%= formatDateTime(item.archived_at) %></td>
              <td data-label="Actions" class="px-4 py-3">
                <form action="/inventory/items/<%= item.id %>/restore" method="POST">
                  <button type="submit" class="rounded-xl border border-emerald-300 px-3 py-2 text-xs font-semibold text-emerald-700">
                    Restore
                  </button>
                </form>
              </td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="6" class="px-4 py-8 text-center text-slate-500">No archived items.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</section>
