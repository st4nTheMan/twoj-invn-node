<% /* Modal for admin-side user password resets. */ %>
<section id="reset-user-password-modal" data-modal class="hidden fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-slate-950/60 p-4 sm:p-6">
  <div class="my-8 w-full max-w-2xl rounded-3xl bg-white shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
      <div>
        <h2 class="text-xl font-semibold text-slate-900">Reset User Password</h2>
        <p id="reset-user-password-description" class="text-sm text-slate-500">Set a new password for this user.</p>
      </div>
      <button
        type="button"
        data-close-modal
        class="rounded-full border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100"
      >
        Close
      </button>
    </div>

    <form id="reset-user-password-form" action="/admin/users/0/password" method="POST" class="p-6">
      <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
        Use this if the user forgot their password. The old password will stop working immediately.
      </div>

      <div class="mt-4 grid gap-4 md:grid-cols-2">
        <div>
          <label class="mb-2 block text-sm font-medium text-slate-700" for="reset-user-password">New Password</label>
          <div class="relative">
            <input
              id="reset-user-password"
              type="password"
              name="password"
              data-required="true"
              autocomplete="new-password"
              class="w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 pr-12 text-sm"
            >
            <button
              type="button"
              data-password-toggle
              data-target="reset-user-password"
              class="absolute inset-y-0 right-3 inline-flex items-center justify-center text-slate-400 transition hover:text-slate-700"
              aria-label="Show password"
              aria-pressed="false"
            >
              <svg data-eye-open xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <svg data-eye-closed xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.585 10.587A2 2 0 0013.414 13.414" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.88 5.09A9.77 9.77 0 0112 4.875c5.25 0 9.246 3.438 10.5 7.125a11.667 11.667 0 01-4.228 5.302M6.61 6.61C4.621 7.873 3.175 9.76 2.5 12c1.254 3.687 5.25 7.125 10.5 7.125 1.706 0 3.318-.363 4.772-1.015" />
              </svg>
            </button>
          </div>
        </div>

        <div>
          <label class="mb-2 block text-sm font-medium text-slate-700" for="reset-user-confirm-password">Confirm Password</label>
          <div class="relative">
            <input
              id="reset-user-confirm-password"
              type="password"
              name="confirm_password"
              data-required="true"
              autocomplete="new-password"
              class="w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 pr-12 text-sm"
            >
            <button
              type="button"
              data-password-toggle
              data-target="reset-user-confirm-password"
              class="absolute inset-y-0 right-3 inline-flex items-center justify-center text-slate-400 transition hover:text-slate-700"
              aria-label="Show password confirmation"
              aria-pressed="false"
            >
              <svg data-eye-open xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <svg data-eye-closed xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.585 10.587A2 2 0 0013.414 13.414" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.88 5.09A9.77 9.77 0 0112 4.875c5.25 0 9.246 3.438 10.5 7.125a11.667 11.667 0 01-4.228 5.302M6.61 6.61C4.621 7.873 3.175 9.76 2.5 12c1.254 3.687 5.25 7.125 10.5 7.125 1.706 0 3.318-.363 4.772-1.015" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div class="mt-6 flex justify-end gap-3">
        <button
          type="button"
          data-close-modal
          class="rounded-2xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700"
        >
          Cancel
        </button>
        <button type="submit" class="rounded-2xl bg-amber-500 px-4 py-3 text-sm font-semibold text-slate-950">
          Update Password
        </button>
      </div>
    </form>
  </div>
</section>
