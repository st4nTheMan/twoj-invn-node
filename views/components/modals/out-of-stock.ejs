<% /* Alert modal shown when a selected checkout item has insufficient stock. */ %>
<section id="out-of-stock-modal" data-modal class="hidden fixed inset-0 z-50 bg-slate-950/60 p-4">
  <div class="mx-auto mt-24 max-w-sm rounded-3xl bg-white p-6 text-center shadow-2xl">
    <h2 class="text-lg font-semibold">Out of Stock</h2>
    <p class="mt-2 text-sm text-slate-500">This item does not have enough stock for checkout.</p>
    <button type="button" data-close-modal class="mt-4 rounded-2xl bg-sky-600 px-4 py-3 text-sm font-semibold text-white">OK</button>
  </div>
</section>
