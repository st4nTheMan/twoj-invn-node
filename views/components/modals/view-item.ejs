<% /* Modal for viewing a single inventory item's read-only details. */ %>
<section id="view-item-modal" data-modal class="hidden fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-slate-950/60 p-4 sm:p-6">
  <div class="my-8 w-full max-w-4xl rounded-3xl bg-white shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-sky-600">View Item</p>
        <h2 id="view-item-modal-name" class="mt-2 text-2xl font-semibold text-slate-900">Item Details</h2>
        <p class="text-sm text-slate-500">Item details are view-only in this modal.</p>
      </div>
      <button
        type="button"
        data-close-modal
        class="rounded-full border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100"
      >
        Close
      </button>
    </div>

    <div class="p-6">
      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <p class="mb-2 text-sm font-medium text-slate-700">Item Number</p>
          <div id="view-item-modal-barcode" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"></div>
        </div>

        <div>
          <p class="mb-2 text-sm font-medium text-slate-700">Item Name</p>
          <div id="view-item-modal-item-name" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"></div>
        </div>

        <div>
          <p class="mb-2 text-sm font-medium text-slate-700">Cost</p>
          <div id="view-item-modal-cost" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"></div>
        </div>

        <div>
          <p class="mb-2 text-sm font-medium text-slate-700">Price</p>
          <div id="view-item-modal-price" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"></div>
        </div>

        <div>
          <p class="mb-2 text-sm font-medium text-slate-700">OH Qty</p>
          <div id="view-item-modal-quantity" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"></div>
        </div>

        <div>
          <p class="mb-2 text-sm font-medium text-slate-700">Min Quantity</p>
          <div id="view-item-modal-min-quantity" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"></div>
        </div>

        <div>
          <p class="mb-2 text-sm font-medium text-slate-700">Max Quantity</p>
          <div id="view-item-modal-max-quantity" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"></div>
        </div>

        <div>
          <p class="mb-2 text-sm font-medium text-slate-700">Category</p>
          <div id="view-item-modal-category" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"></div>
        </div>

        <div>
          <p class="mb-2 text-sm font-medium text-slate-700">Created By</p>
          <div id="view-item-modal-created-by" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"></div>
        </div>

        <div>
          <p class="mb-2 text-sm font-medium text-slate-700">Updated By</p>
          <div id="view-item-modal-updated-by" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"></div>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/inventory/adjustments" class="rounded-2xl bg-amber-500 px-4 py-3 text-sm font-semibold text-slate-950">Open Adjustments</a>
        <button
          id="view-item-archive-button"
          type="button"
          data-open-modal="archive-item-confirm-modal"
          class="rounded-2xl bg-rose-600 px-4 py-3 text-sm font-semibold text-white"
        >
          Archive Item
        </button>
        <button
          type="button"
          data-close-modal
          class="rounded-2xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700"
        >
          Close
        </button>
      </div>
    </div>
  </div>
</section>
