<% /* Payment confirmation modal shown before completing a transaction. */ %>
<section id="transaction-payment-modal" data-modal class="hidden fixed inset-0 z-50 bg-slate-950/60 p-4">
  <div class="mx-auto mt-12 max-w-lg rounded-3xl bg-white p-6 shadow-2xl sm:mt-24">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-lg font-semibold text-slate-900">Complete Transaction</h2>
        <p class="mt-2 text-sm text-slate-500">Choose the payment method, review the total, and confirm the checkout details.</p>
      </div>
      <button type="button" data-close-modal class="rounded-2xl border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-600">Close</button>
    </div>

    <div class="mt-6 space-y-4">
      <div class="rounded-2xl bg-slate-950 px-4 py-4 text-white">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-300">Total Amount</p>
        <p class="mt-2 text-3xl font-semibold">PHP <span id="payment-modal-total">0.00</span></p>
      </div>

      <div>
        <p class="mb-2 block text-sm font-medium text-slate-700">Payment Method</p>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="flex cursor-pointer items-center gap-3 rounded-2xl border border-slate-300 px-4 py-3 text-sm text-slate-700">
            <input id="payment-method-cash" type="radio" name="payment-method-choice" value="cash" class="text-emerald-600 focus:ring-emerald-500" checked>
            <span>
              <span class="block font-semibold text-slate-900">Cash</span>
              <span class="block text-xs text-slate-500">Enter the cash received and confirm the change.</span>
            </span>
          </label>
          <label class="flex cursor-pointer items-center gap-3 rounded-2xl border border-slate-300 px-4 py-3 text-sm text-slate-700">
            <input id="payment-method-credit" type="radio" name="payment-method-choice" value="credit" class="text-violet-600 focus:ring-violet-500">
            <span>
              <span class="block font-semibold text-slate-900">Credit</span>
              <span class="block text-xs text-slate-500">Save the sale to the credit ledger with customer details.</span>
            </span>
          </label>
        </div>
      </div>

      <div id="payment-credit-fields" class="hidden grid gap-4 rounded-2xl border border-violet-200 bg-violet-50 p-4 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-violet-700">Credit Details</p>
          <p class="mt-1 text-sm text-violet-700/80">Select a registered customer first, or leave it blank and register a new customer for this credit sale.</p>
        </div>
        <div class="sm:col-span-2">
          <label for="payment-customer-select" class="mb-2 block text-sm font-medium text-slate-700">Registered Customer</label>
          <select id="payment-customer-select" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm">
            <option value="">Register a new customer</option>
            <% customers.forEach((customer) => { %>
              <option
                value="<%= customer.id %>"
                data-name="<%= customer.name %>"
                data-phone="<%= customer.phone %>"
              >
                <%= customer.name %> • <%= customer.phone %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="sm:col-span-1">
          <label for="payment-customer-name-input" class="mb-2 block text-sm font-medium text-slate-700">Customer Name</label>
          <input id="payment-customer-name-input" type="text" maxlength="150" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm">
        </div>
        <div class="sm:col-span-1">
          <label for="payment-customer-phone-input" class="mb-2 block text-sm font-medium text-slate-700">Phone Number</label>
          <div class="flex overflow-hidden rounded-2xl border border-slate-300 bg-white">
            <span class="inline-flex items-center border-r border-slate-300 bg-slate-100 px-4 text-sm font-semibold text-slate-600">+63</span>
            <input id="payment-customer-phone-input" type="text" inputmode="numeric" autocomplete="tel-national" maxlength="10" placeholder="9XXXXXXXXX" class="w-full border-0 bg-transparent px-4 py-3 text-sm focus:outline-none focus:ring-0">
          </div>
        </div>
      </div>

      <div id="payment-cash-fields">
        <label for="payment-cash-input" class="mb-2 block text-sm font-medium text-slate-700">Cash Received</label>
        <input id="payment-cash-input" type="number" min="0" step="0.01" inputmode="decimal" class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm">
      </div>

      <div id="payment-change-card" class="rounded-2xl bg-emerald-50 px-4 py-4">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-700">Change</p>
        <p class="mt-2 text-2xl font-semibold text-emerald-800">PHP <span id="payment-modal-change">0.00</span></p>
      </div>

      <p id="payment-modal-message" class="text-sm text-rose-600"></p>
    </div>

    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-end">
      <button type="button" data-close-modal class="rounded-2xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700">Cancel</button>
      <button id="confirm-transaction-button" type="button" class="rounded-2xl bg-emerald-500 px-4 py-3 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-60">Confirm Transaction</button>
    </div>
  </div>
</section>
