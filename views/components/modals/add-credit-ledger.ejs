<% /* Modal for manually adding a credit-ledger entry without a linked transaction. */ %>
<section id="add-credit-ledger-modal" data-modal class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-950/60 p-4">
  <div class="mx-auto my-8 max-w-5xl rounded-3xl bg-white p-6 shadow-2xl sm:my-12 max-h-[calc(100vh-4rem)] overflow-y-auto">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-lg font-semibold text-slate-900">Add Credit Entry</h2>
        <p class="mt-2 text-sm text-slate-500">Save a manual ledger balance for a customer, even without processing a checkout transaction first.</p>
      </div>
      <button type="button" data-close-modal class="rounded-2xl border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-600">Close</button>
    </div>

    <form id="credit-ledger-form" action="/credit-ledger" method="POST" class="mt-6 grid gap-6 xl:grid-cols-[1.3fr_1fr]">
      <div class="grid gap-4">
        <div class="rounded-2xl border border-slate-200 p-4">
          <div class="relative">
            <input id="credit-ledger-item-search" type="text" placeholder="Search inventory by item number, name, or category..." class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm">
            <button type="button" id="credit-ledger-item-search-clear" class="absolute inset-y-0 right-4 flex items-center text-slate-400 hover:text-slate-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
              </svg>
            </button>
          </div>

          <div class="mt-4 table-scroll max-h-[22rem] overflow-x-auto overflow-y-auto">
            <table id="credit-ledger-item-table" class="responsive-table min-w-full text-left text-sm">
              <thead class="bg-slate-50 text-slate-600">
                <tr>
                  <th class="px-4 py-3">Item Number</th>
                  <th class="px-4 py-3">Name</th>
                  <th class="px-4 py-3">Price</th>
                  <th class="px-4 py-3">Category</th>
                  <th class="px-4 py-3">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                <% items.forEach((item) => { %>
                  <tr data-row class="hover:bg-slate-50">
                    <td data-label="Item Number" class="px-4 py-3 font-medium"><%= item.barcode %></td>
                    <td data-label="Name" class="px-4 py-3"><%= item.name %></td>
                    <td data-label="Price" class="px-4 py-3">PHP <%= formatCurrency(item.price) %></td>
                    <td data-label="Category" class="px-4 py-3"><%= item.category_name || "No Category" %></td>
                    <td data-label="Action" class="px-4 py-3">
                      <button
                        type="button"
                        class="add-credit-ledger-item-button w-full rounded-xl bg-violet-600 px-3 py-2 text-xs font-semibold text-white sm:w-auto"
                        data-id="<%= item.id %>"
                        data-barcode="<%= item.barcode %>"
                        data-name="<%= item.name %>"
                        data-price="<%= item.price %>"
                      >
                        Select
                      </button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <p id="credit-ledger-item-empty-search" class="hidden pt-4 text-center text-sm text-slate-500">No inventory items found.</p>
        </div>
      </div>

      <div class="grid gap-4">
        <div class="rounded-2xl border border-slate-200 p-4">
          <h3 class="text-sm font-semibold text-slate-900">Selected Items</h3>
          <div class="table-scroll mt-3 overflow-x-auto">
            <table class="responsive-table min-w-full text-left text-sm">
              <thead class="bg-slate-50 text-slate-600">
                <tr>
                  <th class="px-4 py-3">Item</th>
                  <th class="px-4 py-3">Qty</th>
                  <th class="px-4 py-3">Remove</th>
                </tr>
              </thead>
              <tbody id="credit-ledger-selected-items-body">
                <tr id="credit-ledger-no-selected-items-row">
                  <td colspan="3" class="px-4 py-8 text-center text-sm text-slate-500">No items selected.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="credit-ledger-customer-name" class="mb-2 block text-sm font-medium text-slate-700">Customer Name</label>
            <input id="credit-ledger-customer-name" name="customer_name" type="text" maxlength="150" required class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm">
          </div>
          <div>
            <label for="credit-ledger-customer-phone" class="mb-2 block text-sm font-medium text-slate-700">Phone Number</label>
            <input id="credit-ledger-customer-phone" name="customer_phone" type="text" maxlength="50" required class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm">
          </div>
        </div>

        <div>
          <label for="credit-ledger-item-preview" class="mb-2 block text-sm font-medium text-slate-700">Selected Item List</label>
          <textarea id="credit-ledger-item-preview" rows="4" readonly placeholder="Selected inventory items will appear here." class="w-full rounded-2xl border border-slate-300 bg-slate-100 px-4 py-3 text-sm text-slate-600"></textarea>
        </div>

        <div>
          <label for="credit-ledger-total-amount" class="mb-2 block text-sm font-medium text-slate-700">Total Amount</label>
          <input id="credit-ledger-total-amount" type="text" readonly value="0.00" class="w-full rounded-2xl border border-slate-300 bg-slate-100 px-4 py-3 text-sm font-semibold text-slate-700">
        </div>

        <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:justify-end">
          <button type="button" data-close-modal class="rounded-2xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700">Cancel</button>
          <button type="submit" class="rounded-2xl bg-violet-600 px-4 py-3 text-sm font-semibold text-white">Save Credit Entry</button>
        </div>
      </div>
    </form>
  </div>
</section>
