<%
/*
  Reusable filter + sort toolbar.
  Expects:
    selectedSort     - current sort value
    sortOptions      - array of { value, label }
    filterName       - query param name e.g. "category"
    filterLabel      - display label e.g. "Category"
    filterOptions    - array of { value, label } — omit or pass [] to hide filter
    selectedFilter   - current filter value
*/
  const _sortOptions = typeof sortOptions !== 'undefined' ? sortOptions : [];
  const _filterOptions = typeof filterOptions !== 'undefined' ? filterOptions : [];
  const _filterName = typeof filterName !== 'undefined' ? filterName : "filter";
  const _filterLabel = typeof filterLabel !== 'undefined' ? filterLabel : "Filter";
  const _selectedSort = typeof selectedSort !== 'undefined' ? selectedSort : "";
  const _selectedFilter = typeof selectedFilter !== 'undefined' ? selectedFilter : "";
  const _tableId = typeof tableId !== 'undefined' ? tableId : 'table';
  const _sortSelectId = _tableId + '-sort-select';
  const _filterSelectId = _tableId + '-filter-select';
  const _resetButtonId = _tableId + '-filter-reset';
%>
<section id="filter-sort-bar" data-table="<%= _tableId %>" class="mb-6 rounded-3xl bg-white p-4 shadow-soft">
  <div class="flex flex-wrap items-center gap-3">
    <% if (_filterOptions.length) { %>
      <div class="flex items-center gap-2">
        <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide"><%= _filterLabel %></label>
        <select
          id="<%= _filterSelectId %>"
          data-filter-select
          data-param="<%= _filterName %>"
          class="rounded-2xl border-slate-300 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-700"
        >
          <option value="">All</option>
          <% _filterOptions.forEach((opt) => { %>
            <option value="<%= opt.value %>" <%= String(_selectedFilter) === String(opt.value) ? 'selected' : '' %>><%= opt.label %></option>
          <% }) %>
        </select>
      </div>
    <% } %>

    <div class="flex items-center gap-2 <%= _filterOptions.length ? 'border-l border-slate-200 pl-3' : '' %>">
      <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Sort</label>
      <select
        id="<%= _sortSelectId %>"
        data-sort-select
        class="rounded-2xl border-slate-300 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-700"
      >
        <% _sortOptions.forEach((opt) => { %>
          <option value="<%= opt.value %>" <%= _selectedSort === opt.value ? 'selected' : '' %>><%= opt.label %></option>
        <% }) %>
      </select>
    </div>

    <button
      id="<%= _resetButtonId %>"
      type="button"
      data-filter-reset
      class="ml-auto rounded-2xl border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50"
    >
      Reset
    </button>
  </div>
</section>