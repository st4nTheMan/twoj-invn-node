<% /* Shared page header, navigation, and flash-message shell for all views. */ %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Two J's Store</title>
  <script>
    tailwind = {
      config: {
        theme: {
          extend: {
            colors: {
              brand: {
                50: "#eff6ff",
                100: "#dbeafe",
                500: "#0ea5e9",
                600: "#0284c7",
                700: "#0369a1",
                900: "#0f172a"
              }
            },
            boxShadow: {
              soft: "0 20px 40px rgba(15, 23, 42, 0.08)"
            }
          }
        }
      }
    };
  </script>
  <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
  <link rel="stylesheet" href="/public/css/app.css">
</head>
<body class="min-h-screen bg-slate-100 text-slate-900">
  <% if (user) { %>
    <header class="border-b border-slate-200 bg-slate-950 text-white">
      <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
        <div class="flex items-start justify-between gap-4 lg:items-center">
          <div class="max-w-xs sm:max-w-none">
            <a href="/dashboard" class="text-lg font-semibold tracking-wide text-white">Retail Management System</a>
            <p class="text-xs text-slate-400">Stock control, checkout, and sales reporting</p>
            <p class="mt-1 text-xs uppercase tracking-[0.2em] text-sky-300"><%= user.roleDisplayName || user.role || "admin" %></p>
          </div>

          <button
            type="button"
            id="mobile-nav-toggle"
            aria-expanded="false"
            aria-controls="mobile-nav-menu"
            class="relative inline-flex shrink-0 items-center justify-center rounded-2xl border border-slate-700 px-3 py-2 text-slate-200 transition hover:border-sky-400 hover:text-white"
          >
            <span class="sr-only">Open navigation sidebar</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mobile-nav-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5 mobile-nav-icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
            </svg>
            <% if (notifications.count > 0) { %>
              <span class="absolute -right-1 -top-1 inline-flex min-h-5 min-w-5 items-center justify-center rounded-full bg-rose-500 px-1.5 text-xs font-bold text-white"><%= notifications.count %></span>
            <% } %>
          </button>
        </div>

        <div
          id="mobile-nav-menu"
          class="fixed inset-0 z-50 hidden justify-end bg-slate-950/60"
        >
        <div id="mobile-nav-drawer" class="flex h-full w-72 max-w-[88vw] translate-x-full flex-col gap-2 overflow-y-auto border-l border-slate-800 bg-slate-900 p-4 text-sm font-medium shadow-2xl transition-transform duration-300 ease-in-out sm:w-80">
          <div class="mb-2 flex items-center justify-between">
            <div>
              <p class="text-sm font-semibold text-white">Navigation</p>
              <p class="text-xs uppercase tracking-[0.2em] text-sky-300"><%= user.roleDisplayName || user.role || "admin" %></p>
            </div>
            <button
              type="button"
              id="mobile-nav-close"
              class="rounded-full border border-slate-700 p-2 text-slate-300 transition hover:border-rose-400 hover:text-white"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
              </svg>
            </button>
          </div>
          <nav class="flex flex-col gap-2 text-sm font-medium">
            <a href="/dashboard" class="rounded-2xl px-4 py-3 text-left transition <%= currentPath === '/dashboard' ? 'bg-sky-500 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">Dashboard</a>
            <% if (can('inventory.view')) { %>
              <a href="/inventory" class="rounded-2xl px-4 py-3 text-left transition <%= (currentPath === '/inventory' || currentPath.startsWith('/inventory/items')) ? 'bg-sky-500 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">Inventory</a>
            <% } %>
            <% if (can('inventory.adjust')) { %>
              <a href="/inventory/adjustments" class="rounded-2xl px-4 py-3 text-left transition <%= currentPath === '/inventory/adjustments' ? 'bg-amber-500 text-slate-950' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">Adjustments</a>
            <% } %>
            <% if (can('history.view')) { %>
              <a href="/history" class="rounded-2xl px-4 py-3 text-left transition <%= (currentPath === '/history' || currentPath.endsWith('/history')) ? 'bg-slate-200 text-slate-950' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">History</a>
            <% } %>
            <% if (can('price_lookup.view')) { %>
              <a href="/price-lookup" class="rounded-2xl px-4 py-3 text-left transition <%= currentPath === '/price-lookup' ? 'bg-amber-500 text-slate-950' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">Price Lookup</a>
            <% } %>
            <% if (can('transaction.create')) { %>
              <a href="/transaction" class="rounded-2xl px-4 py-3 text-left transition <%= currentPath === '/transaction' ? 'bg-emerald-500 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">Transaction</a>
            <% } %>
            <% if (can('credit_ledger.view')) { %>
              <a href="/credit-ledger" class="rounded-2xl px-4 py-3 text-left transition <%= currentPath === '/credit-ledger' ? 'bg-violet-500 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">Credit Ledger</a>
            <% } %>
            <% if (can('reports.view')) { %>
              <a href="/reports" class="rounded-2xl px-4 py-3 text-left transition <%= currentPath === '/reports' ? 'bg-amber-500 text-slate-950' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">Reports</a>
            <% } %>
            <% if (canAny(['admin.users.view', 'admin.roles.view', 'activity_logs.view'])) { %>
              <a href="/admin" class="rounded-2xl px-4 py-3 text-left transition <%= currentPath === '/admin' ? 'bg-sky-200 text-slate-950' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">Admin</a>
            <% } %>
            <button type="button" data-open-modal="stock-notifications-modal" class="mt-2 flex items-center justify-between rounded-2xl border border-slate-700 px-4 py-3 text-left text-slate-200 transition hover:border-sky-400 hover:text-white">
              <span>Notifications</span>
              <span class="inline-flex items-center gap-2">
                <% if (notifications.count > 0) { %>
                  <span class="inline-flex min-h-5 min-w-5 items-center justify-center rounded-full bg-rose-500 px-1.5 text-xs font-bold text-white"><%= notifications.count %></span>
                <% } %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10 2a4 4 0 00-4 4v1.586L5.293 8.293A1 1 0 005 9v3l-1 2v1h12v-1l-1-2V9a1 1 0 00-.293-.707L14 7.586V6a4 4 0 00-4-4zm0 16a2 2 0 001.995-1.85L12 16H8a2 2 0 002 2z"/>
                </svg>
              </span>
            </button>
            <a href="/logout" class="rounded-2xl border border-slate-700 px-4 py-3 text-left text-slate-300 transition hover:border-rose-400 hover:text-white">Logout</a>
          </nav>
        </div>
        </div>
      </div>
    </header>
  <% } %>

  <main class="<%= user ? 'mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8' : '' %>">
