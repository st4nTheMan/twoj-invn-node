<%- include("partials/header", { title }) %>
<% const state = addItemState || {}; const old = state.old || {}; %>

<section class="mb-6 rounded-3xl bg-white p-6 shadow-soft">
  <p class="text-xs font-semibold uppercase tracking-[0.25em] text-sky-600">Inventory</p>
  <h1 class="mt-2 text-3xl font-semibold">Stock overview</h1>
</section>

<!-- Add Item and Add Category Button -->
<section class="rounded-3xl bg-white p-5 shadow-soft">
  <div class="flex flex-wrap gap-3">
    <button
      type="button"
      data-open-modal="add-item-modal"
      class="rounded-2xl bg-sky-600 px-4 py-3 text-sm font-semibold text-white"
    >
      Add Item
    </button>

    <button
      type="button"
      data-open-modal="add-category-modal"
      class="rounded-2xl bg-emerald-500 px-4 py-3 text-sm font-semibold text-white"
    >
      Add Category
    </button>
  </div>
</section>

<section class="mb-6 rounded-3xl bg-white p-5 shadow-soft">
  <input id="inventory-search" type="text" placeholder="Search by item number, name, or category..." class="w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 text-sm">
</section>

<!-- Inventory Table -->
<section class="mb-6 overflow-x-auto rounded-3xl bg-white shadow-soft">
  <table id="inventory-table" class="min-w-full text-left text-sm">
    <thead class="bg-slate-50 text-slate-600">
      <tr>
        <th class="px-4 py-3">Item Number</th>
        <th class="px-4 py-3">Name</th>
        <th class="px-4 py-3">Price</th>
        <th class="px-4 py-3">Qty</th>
        <th class="px-4 py-3">Category</th>
        <th class="px-4 py-3">Created</th>
        <th class="px-4 py-3">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200">
      <% if (items.length) { items.forEach((item) => { %>
        <tr data-row class="hover:bg-slate-50">
          <td class="px-4 py-3 font-medium"><%= item.barcode %></td>
          <td class="px-4 py-3"><%= item.name %></td>
          <td class="px-4 py-3">PHP <%= formatCurrency(item.price) %></td>
          <td class="px-4 py-3"><%= item.quantity %></td>
          <td class="px-4 py-3"><%= item.category_name || "No Category" %></td>
          <td class="px-4 py-3 text-slate-500"><%= formatDateTime(item.created_at) %></td>
          <td class="px-4 py-3">
            <div class="flex flex-wrap gap-2">
              <a href="/inventory/items/<%= item.id %>" class="rounded-xl border border-sky-300 px-3 py-2 text-xs font-semibold text-sky-700">View Item</a>
              <a href="/inventory/items/<%= item.id %>/price" class="rounded-xl border border-amber-300 px-3 py-2 text-xs font-semibold text-amber-700">Price History</a>
              <a href="/inventory/items/<%= item.id %>/cost" class="rounded-xl border border-emerald-300 px-3 py-2 text-xs font-semibold text-emerald-700">Cost History</a>
            </div>
          </td>
        </tr>
      <% }) } else { %>
        <tr><td colspan="7" class="px-4 py-8 text-center text-slate-500">No items found.</td></tr>
      <% } %>
    </tbody>
  </table>
  <p id="inventory-empty-search" class="hidden p-6 text-center text-sm text-slate-500">No items found.</p>
</section>

<% if (state.error) { %>
  <div id="page-state" data-open-modal="add-item-modal" hidden></div>
<% } %>

<!-- Add Item Modal -->
<section id="add-item-modal" data-modal class="hidden fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-slate-950/60 p-4 sm:p-6">
  <div class="my-8 w-full max-w-3xl rounded-3xl bg-white shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
      <div>
        <h2 class="text-xl font-semibold text-slate-900">Add Item</h2>
        <p class="text-sm text-slate-500">Create a new inventory item.</p>
      </div>
      <button
        type="button"
        data-close-modal
        class="rounded-full border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100"
      >
        Close
      </button>
    </div>

    <form action="/inventory/items" method="POST" class="p-6">
      <% if (state.error) { %>
        <div class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
          <%= state.error %>
        </div>
      <% } %>

      <div class="mt-4 grid gap-4 md:grid-cols-2">
        <div>
          <label for="barcode" class="mb-2 block text-sm font-medium text-slate-700">Item Number</label>
          <input name="barcode" required value="<%= old.barcode || '' %>" placeholder="Item Number" class="w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 text-sm">
        </div>
        <div>
          <label for="name" class="mb-2 block text-sm font-medium text-slate-700">Item Name</label>
          <input name="name" required value="<%= old.name || '' %>" placeholder="Item Name" class="w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 text-sm">
        </div>
        <div>
          <label for="cost" class="mb-2 block text-sm font-medium text-slate-700">Cost</label>
          <input type="number" name="cost" step="0.01" min="0" required value="<%= old.cost || '' %>" placeholder="Cost" class="w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 text-sm">
        </div>
        <div>
          <label for="price" class="mb-2 block text-sm font-medium text-slate-700">Price</label>
          <input type="number" name="price" step="0.01" min="0" required value="<%= old.price || '' %>" placeholder="Price" class="w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 text-sm">
        </div>
        <div class="md:col-span-2">
          <label for="quantity" class="mb-2 block text-sm font-medium text-slate-700">Quantity</label>
          <input type="number" name="quantity" min="0" required value="<%= old.quantity ?? 0 %>" placeholder="OH Quantity" class="w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 text-sm">
        </div>
        <div>
          <label for="min_quantity" class="mb-2 block text-sm font-medium text-slate-700">Min Quantity</label>
          <input type="number" name="min_quantity" min="0" required value="<%= old.min_quantity ?? 5 %>" placeholder="Min Qty" class="w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 text-sm">
        </div>
        <div>
          <label for="max_quantity" class="mb-2 block text-sm font-medium text-slate-700">Max Quantity</label>
          <input type="number" name="max_quantity" min="1" required value="<%= old.max_quantity ?? 100 %>" placeholder="Max Qty" class="w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 text-sm">
        </div>
      </div>

      <select name="category_id" class="mt-4 w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 text-sm">
        <option value="">Select category</option>
        <% categories.forEach((category) => { %>
          <option value="<%= category.id %>" <%= String(old.category_id || '') === String(category.id) ? 'selected' : '' %>><%= category.category_name %></option>
        <% }) %>
      </select>

      <div class="mt-6 flex justify-end gap-3">
        <button
          type="button"
          data-close-modal
          class="rounded-2xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700"
        >
          Cancel
        </button>
        <button type="submit" class="rounded-2xl bg-sky-600 px-4 py-3 text-sm font-semibold text-white">
          Save Item
        </button>
      </div>
    </form>
  </div>
</section>

<!-- Add Category Modal -->
<section id="add-category-modal" data-modal class="hidden fixed inset-0 z-50 bg-slate-950/60 p-4">
  <div class="mx-auto mt-10 max-w-xl rounded-3xl bg-white shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
      <div>
        <h2 class="text-xl font-semibold text-slate-900">Add Category</h2>
        <p class="text-sm text-slate-500">Create a new item category.</p>
      </div>
      <button
        type="button"
        data-close-modal
        class="rounded-full border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100"
      >
        Close
      </button>
    </div>

    <form action="/inventory/categories" method="POST" class="p-6">
      <input
        type="text"
        name="category_name"
        required
        placeholder="Category Name"
        class="w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 text-sm"
      >

      <select class="mt-4 w-full rounded-2xl border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-700">
        <option>Existing categories</option>
        <% categories.forEach((category) => { %>
          <option><%= category.category_name %></option>
        <% }) %>
      </select>

      <div class="mt-6 flex justify-end gap-3">
        <button
          type="button"
          data-close-modal
          class="rounded-2xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700"
        >
          Cancel
        </button>
        <button type="submit" class="rounded-2xl bg-emerald-500 px-4 py-3 text-sm font-semibold text-white">
          Save Category
        </button>
      </div>
    </form>
  </div>
</section>

<%- include("partials/footer") %>
